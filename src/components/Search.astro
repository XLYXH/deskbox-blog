---
import { getPosts, fmtDate } from '../lib/posts';
import { postUrl, url } from '../lib/url';
import { tags } from '../config';
import Icon from './Icon.astro';
const posts = await getPosts();
const index = posts.map((p) => ({ t: p.data.title, d: p.data.description, u: postUrl(p.data.slug), date: fmtDate(p.data.pubDate), tags: p.data.tags }));
---
<dialog class="sp" data-search aria-label="搜索文章">
  <div class="sp__panel" data-search-panel>
    <div class="sp__field">
      <Icon name="search" size={19} />
      <input type="search" placeholder="搜索文章、标签或关键词…" autocomplete="off" spellcheck="false" aria-label="搜索关键词" data-search-input />
      <kbd>Esc</kbd>
    </div>
    <div class="sp__body" data-search-body>
      <p class="sp__hint mono" data-search-status>最近文章</p>
      <ul class="sp__list" role="listbox" data-search-list></ul>
      <div class="sp__tags" data-search-tags>
        {tags.map((t) => <a class="chip" href={url(`/tags/${t.slug}/`)}>{t.name}</a>)}
      </div>
    </div>
    <div class="sp__foot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span class="sp__grow"></span>
      <span>Pagefind 全文索引</span>
    </div>
  </div>
  <script type="application/json" data-search-index set:html={JSON.stringify(index)} />
</dialog>

<style>
  .sp {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: clamp(70px, 12vh, 140px) var(--gutter) 24px;
    border: 0;
    background: transparent;
    color: var(--ink);
  }
  .sp::backdrop {
    background: rgb(15 14 12 / 0.28);
    backdrop-filter: blur(6px);
  }
  .sp[open] .sp__panel {
    animation: sp-in 0.5s var(--spring);
  }
  .sp[open]::backdrop {
    animation: fade 0.3s ease;
  }
  @keyframes sp-in {
    from { opacity: 0; transform: translateY(-14px) scale(0.97); }
  }
  @keyframes fade {
    from { opacity: 0; }
  }
  .sp__panel {
    width: min(100%, 640px);
    margin-inline: auto;
    border-radius: 24px;
    background: color-mix(in srgb, var(--card) 92%, transparent);
    backdrop-filter: blur(24px) saturate(1.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
    box-shadow: inset 0 1px 0 var(--glass-edge), 0 0 0 1px var(--line), var(--shadow-lg);
    overflow: hidden;
  }
  .sp__field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 18px;
    height: 62px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
  }
  .sp__field input {
    flex: 1;
    height: 100%;
    border: 0;
    background: none;
    outline: none;
    font-size: 17px;
    color: var(--ink);
  }
  .sp__field input::-webkit-search-cancel-button {
    display: none;
  }
  kbd {
    font: 500 11px/1 var(--f-mono);
    padding: 4px 6px;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    color: var(--ink-2);
    background: var(--card);
  }
  .sp__body {
    max-height: min(56vh, 480px);
    overflow: auto;
    padding: 10px;
    overscroll-behavior: contain;
  }
  .sp__hint {
    padding: 8px 10px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .sp__list {
    list-style: none;
    padding: 0;
  }
  .sp__list :global(a) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 14px;
    padding: 12px 14px;
    border-radius: 14px;
    transition: background 0.2s;
  }
  .sp__list :global(a[aria-selected='true']),
  .sp__list :global(a:hover) {
    background: var(--accent-soft);
  }
  .sp__list :global(.r-t) {
    font-weight: 600;
    font-size: 15px;
  }
  .sp__list :global(.r-date) {
    font: 12px/1.9 var(--f-mono);
    color: var(--ink-3);
  }
  .sp__list :global(.r-d) {
    grid-column: 1 / -1;
    font-size: 13px;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sp__list :global(mark) {
    background: var(--mark);
    color: inherit;
    border-radius: 3px;
    padding: 0 1px;
  }
  .sp__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 10px 10px 6px;
  }
  .sp__foot {
    display: flex;
    gap: 16px;
    padding: 12px 18px;
    border-top: 1px solid var(--line);
    font-size: 11.5px;
    color: var(--ink-3);
  }
  .sp__foot kbd {
    margin-right: 3px;
  }
  .sp__grow {
    flex: 1;
  }
  @media (max-width: 600px) {
    .sp__foot { display: none; }
    .sp { padding-top: 64px; }
  }
</style>
