---
import { site } from '../config';
import { url } from '../lib/url';
import Icon from './Icon.astro';
const yearNow = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap foot__inner">
    <div class="foot__top">
      <p class="foot__say display">写代码，<em>也写生活。</em></p>
      <ul class="foot__links">
        {site.social.map((s) => (
          <li><a href={url(s.href)} data-magnetic><Icon name={s.icon} size={16} /><span>{s.label}</span></a></li>
        ))}
      </ul>
    </div>
    <a class="foot__word" href={url('/')} aria-label="回到首页" data-wordmark>
      {'DeskBox'.split('').map((c, i) => <span style={`--i:${i}`}>{c}</span>)}
    </a>
    <div class="foot__base mono">
      <span>© {yearNow} {site.name}</span>
      <span class="foot__sep" aria-hidden="true"></span>
      <a href={url('/privacy/')}>隐私</a>
      <a href={url('/rss.xml')}>RSS</a>
      <a href={url('/sitemap-index.xml')}>Sitemap</a>
      <span class="foot__grow"></span>
      <span>Built with Astro · 字体自托管</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(80px, 12vw, 160px);
    border-top: 1px solid var(--line);
    padding: clamp(40px, 6vw, 72px) 0 calc(28px + env(safe-area-inset-bottom));
    overflow: hidden;
  }
  .foot__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }
  .foot__say {
    font-size: clamp(26px, 3.4vw, 40px);
  }
  .foot__say em {
    font-style: normal;
    color: var(--accent);
  }
  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    list-style: none;
  }
  .foot__links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border-radius: 99px;
    border: 1px solid var(--line);
    font-size: 14px;
    color: var(--ink-2);
    transition: color 0.25s, border-color 0.25s, background 0.25s;
  }
  .foot__links a:hover {
    color: var(--ink);
    border-color: var(--line-2);
    background: var(--card);
  }
  .foot__word {
    display: flex;
    justify-content: space-between;
    margin: clamp(28px, 5vw, 56px) 0 clamp(18px, 3vw, 30px);
    font: 600 clamp(64px, 18.5vw, 280px) / 0.8 var(--f-display);
    letter-spacing: -0.045em;
    color: color-mix(in srgb, var(--ink) 7%, transparent);
    user-select: none;
  }
  .foot__word span {
    display: inline-block;
    transition: color 0.5s var(--ease), transform 0.7s var(--spring), text-shadow 0.5s;
  }
  .foot__word span.lit {
    color: var(--ink);
    transform: translateY(-4%);
    text-shadow: 0 0 60px rgb(var(--glow) / 0.35);
  }
  :global([data-theme='dark']) .foot__word span.lit {
    color: var(--accent);
  }
  .foot__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    font-size: 12px;
    color: var(--ink-2);
  }
  .foot__base a:hover {
    color: var(--ink);
  }
  .foot__sep {
    width: 18px;
    height: 1px;
    background: var(--line-2);
  }
  .foot__grow {
    flex: 1;
  }
  @media (max-width: 760px) {
    .foot {
      padding-bottom: calc(96px + env(safe-area-inset-bottom));
    }
  }
</style>
