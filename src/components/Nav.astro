---
import { site } from '../config';
import { url } from '../lib/url';
import Mark from './Mark.astro';
import Icon from './Icon.astro';
---
<header class="nav" data-nav transition:persist="site-nav">
  <a class="nav__brand glass" href={url('/')} aria-label="DeskBox 首页" data-magnetic>
    <Mark size={26} />
    <span class="nav__name">DeskBox</span>
  </a>

  <nav class="nav__links glass" aria-label="主导航" data-blob-host>
    <span class="nav__blob" aria-hidden="true"></span>
    {site.nav.map((n) => (
      <a href={url(n.href)} data-key={n.key} data-nav-link>
        <span>{n.label}</span>
      </a>
    ))}
    <span class="nav__progress" aria-hidden="true"></span>
  </nav>

  <div class="nav__tools glass">
    <button class="nav__search" type="button" data-search-open aria-label="搜索（快捷键 ⌘K 或 /）">
      <Icon name="search" size={17} />
      <kbd class="nav__kbd">⌘K</kbd>
    </button>
    <button class="nav__theme" type="button" data-theme-toggle aria-label="切换深色模式">
      <Icon name="sun" size={17} class="i-sun" />
      <Icon name="moon" size={17} class="i-moon" />
    </button>
  </div>

  <div class="cord" aria-hidden="true">
    <span class="cord__line"></span>
    <span class="cord__bead" data-cord title="拉一下：开/关台灯"></span>
  </div>
</header>

<svg class="sr-only" aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute">
  <defs data-glass-defs></defs>
</svg>

<style>
  .nav {
    position: fixed;
    inset: 14px 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    width: min(100% - 2 * var(--gutter) + 16px, var(--wrap) + 16px);
    margin-inline: auto;
    height: 50px;
    pointer-events: none;
  }
  .nav > * {
    pointer-events: auto;
  }
  .nav__brand,
  .nav__links,
  .nav__tools,
  .cord {
    transition: transform 0.6s var(--ease), opacity 0.4s;
  }
  .nav.is-hidden .nav__brand,
  .nav.is-hidden .nav__links,
  .nav.is-hidden .nav__tools {
    transform: translateY(-140%);
  }
  .nav.is-hidden .cord {
    transform: translateY(-160px);
  }

  .glass {
    height: 50px;
  }
  .nav__brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 18px 0 12px;
    font: 600 16px/1 var(--f-display);
    letter-spacing: -0.01em;
  }
  .nav__brand :global(.mark__beam) {
    transform-origin: 50% 10%;
    transition: transform 0.6s var(--spring), opacity 0.4s;
  }
  .nav__brand:hover :global(.mark__beam) {
    transform: scaleX(1.25);
  }

  .nav__links {
    display: flex;
    align-items: center;
    padding: 5px;
    gap: 2px;
  }
  .nav__links a {
    white-space: nowrap;
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    height: 40px;
    padding: 0 16px;
    border-radius: 99px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    transition: color 0.3s;
  }
  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    color: var(--ink);
  }
  .nav__blob {
    position: absolute;
    z-index: 0;
    top: 5px;
    left: 0;
    height: 40px;
    width: var(--bw, 0px);
    transform: translateX(var(--bx, 0px)) scaleX(var(--bs, 1));
    border-radius: 99px;
    background: color-mix(in srgb, var(--card) 85%, transparent);
    box-shadow:
      inset 0 1px 0 var(--glass-edge),
      0 0 0 1px var(--line),
      0 6px 16px -8px rgb(0 0 0 / 0.35),
      0 0 22px -6px rgb(var(--glow) / 0.45);
    opacity: var(--bo, 0);
    transition:
      transform 0.55s var(--spring),
      width 0.55s var(--spring),
      opacity 0.3s;
  }
  .nav__progress {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--accent));
    transform-origin: left;
    transform: scaleX(var(--read, 0));
    opacity: 0;
    transition: opacity 0.4s;
  }
  :global(body[data-reading]) .nav__progress {
    opacity: 1;
  }

  .nav__tools {
    justify-self: end;
    display: flex;
    align-items: center;
    padding: 5px;
    gap: 2px;
  }
  .nav__tools button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    min-width: 40px;
    justify-content: center;
    padding: 0 12px;
    border-radius: 99px;
    color: var(--ink-2);
    transition: color 0.25s, background 0.25s;
  }
  .nav__tools button:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--card) 70%, transparent);
  }
  .nav__kbd {
    font: 500 11px/1 var(--f-mono);
    padding: 4px 6px;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    color: var(--ink-2);
  }
  .nav__theme {
    padding: 0 !important;
    width: 40px;
  }
  .nav__theme :global(svg) {
    position: absolute;
    transition: transform 0.6s var(--spring), opacity 0.3s;
  }
  .nav__theme :global(.i-moon) {
    opacity: 0;
    transform: rotate(-60deg) scale(0.5);
  }
  :global([data-theme='dark']) .nav__theme :global(.i-sun) {
    opacity: 0;
    transform: rotate(60deg) scale(0.5);
  }
  :global([data-theme='dark']) .nav__theme :global(.i-moon) {
    opacity: 1;
    transform: none;
  }

  /* ---------- 台灯拉绳 ---------- */
  .cord {
    position: absolute;
    right: 25px;
    top: 50px;
    width: 20px;
    height: 70px;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: 50% 0;
    pointer-events: none;
  }
  .cord__line {
    width: 1.5px;
    height: calc(30px + var(--pull, 0px));
    background: linear-gradient(var(--line-2), var(--ink-3));
  }
  .cord__bead {
    pointer-events: auto;
    width: 13px;
    height: 17px;
    margin-top: -1px;
    border-radius: 7px 7px 8px 8px;
    background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--accent) 60%, #fff), var(--accent) 60%, var(--accent-ink));
    box-shadow: 0 0 0 4px transparent, 0 4px 10px -2px rgb(var(--glow) / 0.6);
    cursor: grab;
    touch-action: none;
    transition: box-shadow 0.3s;
  }
  :global([data-theme='dark']) .cord__bead {
    box-shadow: 0 0 14px 2px rgb(var(--glow) / 0.55), 0 0 0 4px transparent;
  }
  .cord__bead:hover {
    box-shadow: 0 0 0 5px var(--accent-soft), 0 6px 14px -2px rgb(var(--glow) / 0.7);
  }
  .cord.is-dragging .cord__bead {
    cursor: grabbing;
  }
  .cord.swing {
    animation: swing 1.4s var(--ease);
  }
  @keyframes swing {
    0% { transform: rotate(0); }
    18% { transform: rotate(9deg); }
    38% { transform: rotate(-6deg); }
    58% { transform: rotate(3.5deg); }
    78% { transform: rotate(-1.5deg); }
    100% { transform: rotate(0); }
  }

  /* ---------- 移动端：底部玻璃 Dock ---------- */
  @media (max-width: 760px) {
    .nav {
      grid-template-columns: 1fr auto;
      inset: 10px 0 auto;
      height: 46px;
    }
    .glass {
      height: 46px;
    }
    .nav__links {
      position: fixed;
      left: 50%;
      bottom: calc(12px + env(safe-area-inset-bottom));
      transform: translateX(-50%);
      height: 56px;
      width: max-content;
      padding: 6px;
    }
    .nav.is-hidden .nav__links {
      transform: translateX(-50%);
    }
    .nav__links a {
      height: 44px;
      padding: 0 13px;
      font-size: 13.5px;
    }
    .nav__blob {
      top: 6px;
      height: 44px;
    }
    .nav__progress {
      bottom: 2px;
    }
    .nav__kbd {
      display: none;
    }
    .nav__tools button {
      height: 36px;
      min-width: 36px;
      padding: 0 9px;
    }
    .nav__theme {
      width: 36px;
    }
    .cord {
      top: 46px;
      right: 22px;
    }
    .nav__brand {
      padding: 0 14px 0 10px;
    }
  }
  @media (max-width: 360px) {
    .nav__links a {
      padding: 0 10px;
    }
  }
</style>
