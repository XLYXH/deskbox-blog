---
// 列表悬停时跟随鼠标的预览卡
---
<div class="pv" data-preview aria-hidden="true">
  <div class="pv__art">
    <img data-pv-img alt="" width="320" height="168" decoding="async" />
    <span class="pv__glyph" data-pv-glyph></span>
  </div>
  <p class="pv__title" data-pv-title></p>
  <p class="pv__meta mono" data-pv-meta></p>
</div>
<style>
  .pv {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: 300px;
    padding: 10px 10px 14px;
    margin: 24px 0 0 28px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--card) 80%, transparent);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: inset 0 1px 0 var(--glass-edge), 0 0 0 1px var(--line), var(--shadow-lg);
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    transition: opacity 0.3s, scale 0.45s var(--spring);
    will-change: transform;
  }
  .pv.on {
    opacity: 1;
    scale: 1;
  }
  .pv__art {
    position: relative;
    aspect-ratio: 300 / 158;
    border-radius: 12px;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 20% 10%, oklch(0.82 0.12 var(--hue)), transparent 60%),
      radial-gradient(90% 90% at 90% 100%, oklch(0.55 0.16 calc(var(--hue) + 30)), transparent 70%),
      oklch(0.3 0.05 var(--hue));
  }
  .pv__art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .pv.has-img img {
    opacity: 1;
  }
  .pv.has-img .pv__glyph {
    opacity: 0;
  }
  .pv__glyph {
    position: absolute;
    right: 14px;
    bottom: -18px;
    font: 700 112px/1 var(--f-display);
    color: rgb(255 255 255 / 0.92);
    mix-blend-mode: overlay;
    text-shadow: 0 0 40px rgb(255 255 255 / 0.4);
  }
  .pv__title {
    margin: 12px 4px 4px;
    font-weight: 600;
    font-size: 14px;
    line-height: 1.45;
  }
  .pv__meta {
    margin: 0 4px;
    font-size: 11.5px;
    color: var(--ink-2);
  }
</style>
