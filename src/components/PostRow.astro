---
import type { CardData } from '../lib/meta';
import { postUrl, tagUrl } from '../lib/url';
import Icon from './Icon.astro';
interface Props { p: CardData; index: number; total?: number }
const { p, index } = Astro.props;
const no = String(index + 1).padStart(2, '0');
---
<li class="row rise" style={`--i:${index % 8}`} data-item data-tags={p.tagSlugs.join('|')}>
  <a class="row__link" href={postUrl(p.slug)} data-row data-title={p.title} data-glyph={p.glyph} data-hue={p.hue}
     data-cover={p.cover || undefined} data-meta={`${p.date} · ${p.minutes} 分钟`}>
    <span class="row__no mono" aria-hidden="true">{no}</span>
    <time class="row__date mono" datetime={p.iso}>{p.date}</time>
    <span class="row__main">
      <span class="row__title" style={`view-transition-name: t-${p.slug}`}>{p.title}</span>
      <span class="row__desc">{p.description}</span>
    </span>
    <span class="row__meta mono">{p.minutes} min</span>
    <span class="row__go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
  </a>
  {p.tags.length > 0 && (
    <span class="row__tags">
      {p.tags.map((t, i) => <a class="chip" href={tagUrl(p.tagSlugs[i])}>{t}</a>)}
    </span>
  )}
</li>

<style>
  .row {
    position: relative;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .row__link {
    position: relative;
    display: grid;
    grid-template-columns: 44px 108px minmax(0, 1fr) 70px 40px;
    align-items: baseline;
    gap: 0 20px;
    padding: 28px 8px 58px;
    transition: padding 0.5s var(--ease);
  }
  .row__link::before {
    /* 悬停时从左扫入的底色 */
    content: '';
    position: absolute;
    inset: 0 -14px;
    border-radius: var(--r);
    background: linear-gradient(90deg, var(--accent-soft), transparent 70%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
    z-index: -1;
  }
  .row__no {
    font-size: 12px;
    color: var(--ink-3);
    transition: color 0.3s;
  }
  .row__date {
    font-size: 13px;
    color: var(--ink-2);
  }
  .row__main {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .row__title {
    font: 600 clamp(19px, 1.9vw, 24px) / 1.38 var(--f-display);
    letter-spacing: -0.01em;
    width: fit-content;
    max-width: 100%;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat;
    transition: background-size 0.6s var(--ease), color 0.3s;
  }
  .row__desc {
    font-size: 14.5px;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 60ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .row__meta {
    font-size: 12px;
    color: var(--ink-3);
    text-align: right;
  }
  .row__go {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--ink-2);
    align-self: center;
    transition: background 0.4s var(--ease), color 0.3s, transform 0.5s var(--spring), border-color 0.3s;
  }
  .row__tags {
    position: absolute;
    left: calc(8px + 44px + 108px + 40px);
    bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  @media (hover: hover) {
    .row__link:hover::before {
      transform: scaleX(1);
    }
    .row__link:hover .row__title {
      background-size: 100% 1.5px;
    }
    .row__link:hover .row__no {
      color: var(--accent);
    }
    .row__link:hover .row__go {
      background: var(--ink);
      color: var(--paper);
      border-color: var(--ink);
      transform: rotate(45deg);
    }
  }
  .row__link:focus-visible {
    outline-offset: -2px;
  }
  @media (max-width: 860px) {
    .row__link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px 12px;
      padding: 22px 2px 62px;
    }
    .row__no,
    .row__go {
      display: none;
    }
    .row__date {
      grid-row: 1;
      font-size: 12px;
    }
    .row__meta {
      grid-row: 1;
      grid-column: 2;
    }
    .row__main {
      grid-column: 1 / -1;
    }
    .row__tags {
      left: 2px;
      bottom: 20px;
    }
  }
</style>
