---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import Preview from '../components/Preview.astro';
import Icon from '../components/Icon.astro';
import { getPosts, getStats, fmtDate } from '../lib/posts';
import { cardData } from '../lib/meta';
import { site, tags } from '../config';
import { url, postUrl, tagUrl } from '../lib/url';
import { Image } from 'astro:assets';

const posts = await getPosts();
const cards = await Promise.all(posts.map(cardData));
const stats = await getStats();
const [feat] = posts;
const featCard = cards[0];
const recent = cards.slice(0, 8);
const tagCount = (n: string) => posts.filter((p) => (p.data.tags as string[]).includes(n)).length;
const seriesMap = new Map<string, typeof cards>();
cards.forEach((c) => c.series && seriesMap.set(c.series.name, [...(seriesMap.get(c.series.name) ?? []), c]));
const series = [...seriesMap.entries()].map(([name, list]) => ({ name, list: list.sort((a, b) => a.series!.order - b.series!.order) }));
---
<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="eyebrow rise"><span data-greet>你好</span>，欢迎来到 {site.name}</p>
      <h1 id="hero-title" class="hero__title display">
        <span class="hero__line rise" style="--i:1"><span data-decode="250">写代码，</span></span>
        <span class="hero__line hero__line--accent rise" style="--i:2">
          <span data-decode="520">也写生活。</span>
          <svg class="hero__scribble" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M3 15c40-8 80-10 122-6s92 7 135-1c14-3 26-4 37-2" /></svg>
        </span>
      </h1>
      <p class="hero__lead rise" style="--i:3">{site.author.bio}做过的项目、技术上的判断，以及读书和生活里值得停一下的瞬间。</p>
      <div class="hero__cta rise" style="--i:4">
        <a class="btn" href={url('/blog/')} data-magnetic>开始阅读 <Icon name="right" /></a>
        <button class="btn btn--ghost" type="button" data-search-open data-magnetic><Icon name="search" /> 搜索 <kbd class="k">⌘K</kbd></button>
      </div>
    </div>

    <div class="desk" aria-label="站点概览">
      <div class="card spot w-clock rise" style="--i:2" data-clock>
        <p class="w-label mono">LOCAL TIME</p>
        <p class="clock num"><span data-clock-hm>--:--</span><span class="clock__s" data-clock-s>--</span></p>
        <p class="w-sub" data-clock-day>&nbsp;</p>
        <span class="w-lamp" aria-hidden="true"></span>
      </div>
      <div class="card spot w-stats rise" style="--i:3">
        <p class="w-label mono">ON THE DESK</p>
        <dl class="stats">
          <div><dt>文章</dt><dd class="num" data-count={stats.posts}>{stats.posts}</dd></div>
          <div><dt>标签</dt><dd class="num" data-count={stats.tags}>{stats.tags}</dd></div>
          <div><dt>总字数</dt><dd class="num" data-count={stats.words}>{stats.words.toLocaleString('zh-CN')}</dd></div>
          <div><dt>写了</dt><dd><span class="num" data-count={stats.days}>{stats.days}</span><small> 天</small></dd></div>
        </dl>
      </div>
      <a class="card spot w-latest rise" style="--i:4" href={postUrl(featCard.slug)}>
        <p class="w-label mono">LATEST · {featCard.date}</p>
        <p class="w-latest__t">{featCard.title}</p>
        <span class="w-latest__go"><Icon name="arrow" size={16} /></span>
      </a>
    </div>
  </section>

  {feat && (
    <section class="feature wrap" aria-label="最新文章">
      <a class="feature__card card spot" href={postUrl(featCard.slug)} data-tilt="4">
        <div class="feature__art">
          {feat.data.cover ? (
            <Image src={feat.data.cover} alt={feat.data.coverAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 640px, 100vw" loading="eager" />
          ) : (
            <span class="feature__glyph">{featCard.glyph}</span>
          )}
          <span class="feature__glare" aria-hidden="true"></span>
        </div>
        <div class="feature__body">
          <p class="eyebrow">最新一篇</p>
          <h2 class="feature__title display">{featCard.title}</h2>
          <p class="feature__desc">{featCard.description}</p>
          <p class="feature__meta mono">
            <span>{featCard.date}</span><span>{featCard.words.toLocaleString('zh-CN')} 字</span><span>{featCard.minutes} 分钟</span>
          </p>
          <span class="feature__tags">{featCard.tags.map((t) => <span class="chip">{t}</span>)}</span>
          <span class="feature__read">阅读全文 <Icon name="right" size={16} /></span>
        </div>
      </a>
    </section>
  )}

  <section class="recent wrap" aria-labelledby="recent-title">
    <header class="sec-head rise">
      <p class="eyebrow">Recent writing</p>
      <h2 id="recent-title" class="display">最近写的</h2>
      <a class="sec-head__more" href={url('/blog/')} data-magnetic>全部 {posts.length} 篇 <Icon name="arrow" size={15} /></a>
    </header>
    <ol class="rows">
      {recent.map((p, i) => <PostRow p={p} index={i} />)}
    </ol>
  </section>

  <section class="shelf wrap" aria-label="专栏与标签">
    {series.map((s) => (
      <div class="card spot shelf__series rise">
        <p class="w-label mono">SERIES · 专栏</p>
        <h3 class="display">{s.name}</h3>
        <ol>
          {s.list.map((c) => (
            <li><a href={postUrl(c.slug)}><span class="mono">{String(c.series!.order).padStart(2, '0')}</span>{c.title}</a></li>
          ))}
        </ol>
      </div>
    ))}
    <div class="card spot shelf__tags rise" style="--i:1">
      <p class="w-label mono">TAGS · 标签</p>
      <ul>
        {tags.map((t) => (
          <li>
            <a href={tagUrl(t.slug)} data-magnetic="0.18">
              <span class="t-name">{t.name}</span>
              <span class="t-count mono">{tagCount(t.name)}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="shelf__more" href={url('/archive/')}>按时间翻翻归档 <Icon name="right" size={15} /></a>
    </div>
  </section>

  <Preview />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: end;
    padding-top: clamp(20px, 4vw, 56px);
  }
  .hero__title {
    margin: 22px 0 26px;
    font-size: clamp(52px, 8.6vw, 128px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  .hero__line {
    display: block;
    position: relative;
    width: fit-content;
    white-space: nowrap;
  }
  .hero__line--accent {
    color: var(--accent);
  }
  .hero__scribble {
    position: absolute;
    left: -2%;
    bottom: -0.06em;
    width: 104%;
    height: 0.22em;
    overflow: visible;
  }
  .hero__scribble path {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
    opacity: 0.55;
    animation: draw 1.4s 1.1s var(--ease) forwards;
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  .hero__lead {
    max-width: 34em;
    font-size: clamp(16px, 1.3vw, 18px);
    color: var(--ink-2);
    line-height: 1.85;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .k {
    font: 500 11px/1 var(--f-mono);
    padding: 4px 6px;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    color: var(--ink-2);
  }

  /* ---------- 桌面小组件 ---------- */
  .desk {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .desk .card {
    padding: 20px 22px;
    overflow: hidden;
  }
  .w-label {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--ink-3);
  }
  .w-clock {
    grid-column: 1 / -1;
  }
  .clock {
    margin-top: 8px;
    font: 500 clamp(48px, 5vw, 68px) / 1 var(--f-display);
    letter-spacing: -0.03em;
  }
  .clock__s {
    margin-left: 8px;
    font: 500 16px/1 var(--f-mono);
    color: var(--accent);
    vertical-align: top;
  }
  .w-sub {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .w-lamp {
    position: absolute;
    right: -40px;
    top: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(var(--glow) / 0.35), transparent 65%);
    filter: blur(6px);
    pointer-events: none;
    animation: breathe 6s ease-in-out infinite;
  }
  @keyframes breathe {
    50% { transform: scale(1.12); opacity: 0.75; }
  }
  .w-stats {
    grid-column: 1 / -1;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 14px;
  }
  .stats dt {
    font-size: 12px;
    color: var(--ink-2);
  }
  .stats dd {
    margin-top: 4px;
    font: 600 22px/1.1 var(--f-display);
    letter-spacing: -0.02em;
  }
  .stats small {
    font: 400 12px var(--f-sans);
    color: var(--ink-2);
  }
  .w-latest {
    grid-column: 1 / -1;
    display: block;
    transition: transform 0.5s var(--ease);
  }
  .w-latest__t {
    margin-top: 10px;
    padding-right: 40px;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.5;
  }
  .w-latest__go {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    transition: transform 0.5s var(--spring);
  }
  .w-latest:hover .w-latest__go {
    transform: rotate(45deg) scale(1.08);
  }

  /* ---------- 精选大卡片 ---------- */
  .feature {
    margin-top: clamp(64px, 9vw, 120px);
  }
  .feature__card {
    display: grid;
    align-items: stretch;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    border-radius: var(--r-lg);
    overflow: hidden;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .feature__art {
    position: relative;
    min-height: 300px;
    background: #f1eee8;
    overflow: hidden;
  }
  .feature__art :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 1.2s var(--ease);
  }
  .feature__card:hover .feature__art :global(img) {
    transform: scale(1.04);
  }
  .feature__glare {
    position: absolute;
    inset: 0;
    background: radial-gradient(500px circle at var(--gx, 50%) var(--gy, 50%), rgb(255 255 255 / 0.25), transparent 50%);
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .feature__card:hover .feature__glare {
    opacity: 1;
  }
  .feature__glyph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 700 200px/1 var(--f-display);
  }
  .feature__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: clamp(28px, 4vw, 52px);
  }
  .feature__title {
    font-size: clamp(28px, 3.2vw, 44px);
  }
  .feature__desc {
    color: var(--ink-2);
    line-height: 1.8;
  }
  .feature__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 12.5px;
    color: var(--ink-2);
  }
  .feature__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .feature__read {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-top: 10px;
    font-weight: 500;
    color: var(--accent);
  }
  .feature__read :global(svg) {
    transition: transform 0.4s var(--ease);
  }
  .feature__card:hover .feature__read :global(svg) {
    transform: translateX(5px);
  }

  /* ---------- 最近 ---------- */
  .recent {
    margin-top: clamp(80px, 11vw, 150px);
  }
  .sec-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 10px 20px;
    margin-bottom: 26px;
  }
  .sec-head .eyebrow {
    grid-column: 1 / -1;
  }
  .sec-head h2 {
    font-size: clamp(34px, 4.6vw, 60px);
  }
  .sec-head__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 16px;
    border-radius: 99px;
    border: 1px solid var(--line-2);
    font-size: 14px;
    transition: background 0.3s;
  }
  .sec-head__more:hover {
    background: var(--card);
  }
  .rows {
    padding: 0;
  }

  /* ---------- 书架：专栏 + 标签 ---------- */
  .shelf {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: clamp(64px, 9vw, 110px);
  }
  .shelf .card {
    padding: clamp(22px, 3vw, 34px);
  }
  .shelf h3 {
    margin: 12px 0 18px;
    font-size: clamp(24px, 2.4vw, 32px);
  }
  .shelf__series ol {
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
  }
  .shelf__series a {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px dashed var(--line-2);
    font-weight: 500;
    transition: color 0.25s, padding 0.4s var(--ease);
  }
  .shelf__series a:hover {
    color: var(--accent);
    padding-left: 6px;
  }
  .shelf__series .mono {
    font-size: 12px;
    color: var(--accent);
  }
  .shelf__tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 16px 0 22px;
    padding: 0;
    list-style: none;
  }
  .shelf__tags a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 8px 0 18px;
    border-radius: 99px;
    border: 1px solid var(--line-2);
    font-size: 16px;
    font-weight: 500;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .shelf__tags a:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .t-count {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 32px;
    border-radius: 99px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 12px;
  }
  .shelf__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .shelf__more:hover {
    color: var(--accent);
  }

  /* 滚动驱动：精选卡片从裁切中展开，小组件视差 */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .feature {
        animation: unclip linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
      .sec-head h2 {
        animation: slide-in linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
      .desk {
        animation: drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 700px;
      }
    }
  }
  @keyframes unclip {
    from { clip-path: inset(6% 7% 6% 7% round 40px); opacity: 0.3; }
    to { clip-path: inset(0 0 0 0 round 28px); opacity: 1; }
  }
  @keyframes slide-in {
    from { translate: -6% 0; opacity: 0; }
    to { translate: 0 0; opacity: 1; }
  }
  @keyframes drift {
    to { translate: 0 -60px; }
  }
  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .feature__card {
      grid-template-columns: 1fr;
    }
    .feature__art {
      min-height: 0;
      aspect-ratio: 1024 / 537;
    }
  }
  @media (max-width: 760px) {
    .shelf {
      grid-template-columns: 1fr;
    }
    .hero__title {
      font-size: clamp(46px, 14.5vw, 72px);
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 16px;
    }
    .clock {
      font-size: 52px;
    }
  }
</style>
